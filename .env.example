# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather. Никому не показывайте, не отправляйте в чаты и не коммитьте.
BOT_TOKEN=

# Название бизнеса — показывается клиентам в боте и в шапке админки
BUSINESS_NAME=Мой салон

# Telegram ID администраторов через запятую: им приходят уведомления о новых,
# отменённых и оплаченных записях. Свой ID можно узнать у бота @userinfobot.
ADMIN_IDS=

# Доступ в веб-админку (HTTP Basic). Пока ADMIN_PASSWORD не задан, админка закрыта.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Часовой пояс бизнеса: в нём хранятся и показываются все времена записей
TIMEZONE=Europe/Moscow

# База данных. SQLite подходит для старта и небольшого потока записей.
DATABASE_URL=sqlite:///./booking.db

# Шаг сетки времени (мин), минимум до начала записи (мин),
# на сколько дней вперёд можно записаться, за сколько минут напоминать
SLOT_STEP_MIN=30
MIN_LEAD_MIN=60
BOOKING_DAYS_AHEAD=14
REMINDER_BEFORE_MIN=120
# Клиент может сам перенести запись не позднее чем за столько минут до визита
RESCHEDULE_BEFORE_MIN=60
# Через сколько часов после визита неотмеченная запись сама станет «состоялась» (0 — выключено)
AUTO_DONE_AFTER_HOURS=24

# --- Предоплата через Telegram Payments (необязательно) ---
# Токен платёжного провайдера: @BotFather → /mybots → ваш бот → Payments.
# Сначала возьмите ТЕСТОВЫЙ токен провайдера и проверьте оплату тестовой картой.
# Предоплата включается, только когда заданы и токен, и процент больше нуля.
PAYMENT_PROVIDER_TOKEN=
# Какую часть стоимости услуги просить заранее (0 — предоплаты нет)
PREPAYMENT_PERCENT=0
PAYMENT_CURRENCY=RUB
# Сколько минут держать время за клиентом, пока он оплачивает; потом бронь снимается
PAYMENT_HOLD_MIN=15
